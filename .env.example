# Proxmox connection
PROXMOX_HOST=192.168.1.100
PROXMOX_PORT=8006
PROXMOX_VERIFY_SSL=false
# Seconds per API request; a wedged host must not pin a worker thread forever
PROXMOX_TIMEOUT=15

# Auth: API token (recommended — give it its own role, see README "Least privilege")
PROXMOX_USER=mcp@pve
PROXMOX_TOKEN_NAME=mcp
PROXMOX_TOKEN_VALUE=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Auth: password (alternative)
# PROXMOX_PASSWORD=secret

# Risk tier for elevated operations:
#   read      — only read-only tools (default)
#   lifecycle — + start/stop/reboot/clone/migrate/snapshot-create
#   all       — + snapshot delete/rollback
PROXMOX_RISK_LEVEL=read

# Narrow the tool surface further, within the risk tier. Unset = every tool the
# tier allows. Unknown names are a startup error, not a silent no-op.
# PROXMOX_TOOLS_ALLOW=list_nodes,list_vms,list_containers,get_cluster_resources

# Mask cipassword/sshkeys in every response (default true)
# PROXMOX_REDACT_SECRETS=true

# ── Transport ──────────────────────────────────────────────────────────────
# stdio (default) or streamable-http. PROXMOX_MCP_* rather than PROXMOX_*
# because Kubernetes injects <SERVICE>_PORT for every Service it links.
# PROXMOX_MCP_TRANSPORT=streamable-http
# PROXMOX_MCP_HOST=0.0.0.0
# PROXMOX_MCP_PORT=8000
# PROXMOX_MCP_PATH=/mcp
# PROXMOX_MCP_JSON_RESPONSE=true
# Required once PROXMOX_MCP_HOST is not loopback — the Host headers to accept.
# '*' disables the check, for when a proxy in front already validates it.
# PROXMOX_MCP_ALLOWED_HOSTS=proxmox-mcp.example.com,proxmox-mcp:8000
# Browser origins allowed to call the endpoint. Empty = same-origin only.
# PROXMOX_MCP_ALLOWED_ORIGINS=https://proxmox-mcp.example.com

# Sentry (optional) — inert while SENTRY_DSN is unset
# SENTRY_DSN=https://<key>@sentry.example.com/<project>
# SENTRY_ENVIRONMENT=homelab
# SENTRY_TRACES_SAMPLE_RATE=1.0
# Tool arguments and results as span data — get_vm_config carries ssh keys
# SENTRY_SEND_DEFAULT_PII=false
